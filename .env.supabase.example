# Example configuration for a PostgreSQL database hosted in Supabase (free plan,
# Session pooler). Copy this file to .env.supabase, fill in the real values there and
# never commit either file: .env.supabase is ignored by .gitignore.
# All values below are placeholders, not real credentials.

# Session pooler (port 5432). Do NOT use the Transaction pooler (port 6543) or the
# direct IPv6 connection. Keep sslmode=require in the URL.
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Username format: postgres.<project-id> (the dots and the id come from Supabase).
DB_USER=postgres.<project-id>

# Supabase database password, exactly as configured in the dashboard. It travels in
# DB_PASSWORD as-is: do not URL-encode it and do not put it anywhere else.
DB_PASSWORD=replace-with-your-supabase-password

# Max connections kept by HikariCP in the prod profile. The free pooler is small.
DB_POOL_SIZE=5

# The service must run with the prod profile to read the cloud configuration.
SPRING_PROFILES_ACTIVE=prod

# Port exposed by the service (the dev default is 8080; prod has no default).
SERVER_PORT=8080
