# Example values only. Copy this file to .env and edit it.
# .env is ignored by Git and by the Docker build context: never commit it
# and never put real credentials here.

# --- Sensitive (docker-compose refuses to start without it) ---
DB_PASSWORD=

# --- Shared with the postgres container and the application ---
DB_USER=postgres

# --- Application ---
# Inside the docker-compose network the app reaches PostgreSQL as "postgres";
# docker-compose.yml builds that DB_URL itself. This DB_URL is only used when
# you run the application OUTSIDE Docker (spring-boot:run or IntelliJ).
DB_URL=jdbc:postgresql://localhost:5432/shareway_booking
SERVER_PORT=8080
