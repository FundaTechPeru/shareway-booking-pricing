# Example values only. Copy this file to .env and edit it.
# .env is ignored by Git and by the Docker build context: never commit it
# and never put real credentials here.

# --- Sensitive (docker-compose refuses to start without it) ---
DB_PASSWORD=

# --- Shared with the postgres container and the application ---
DB_USER=postgres

# --- Application ---
# Inside the docker-compose network the app reaches PostgreSQL as "postgres";
# docker-compose.yml builds that DB_URL itself. This DB_URL is only used when
# you run the application OUTSIDE Docker (spring-boot:run or IntelliJ).
DB_URL=jdbc:postgresql://localhost:5432/shareway_booking
SERVER_PORT=8080

# --- ShareWay integration (optional in the dev profile) ---
# Leave them commented to use the development values: an empty JWT_SECRET is NOT the same
# as an unset one. Outside dev/test/local both secrets are mandatory and must be real.
# JWT_SECRET=
# INTERNAL_API_KEY=
# PAYMENTS_URL=https://shareway-payments-settlement-service.onrender.com
# TRIP_EXECUTION_URL=https://shareway-trip-execution.onrender.com
# The dev profile keeps the outbox queued (nothing is sent to Render); true sends it.
# OUTBOX_RELAY_ENABLED=false
